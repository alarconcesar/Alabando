<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".ui.buscar.BuscarFragment">

    <TextView
        android:id="@+id/textView"
        style="?attr/textAppearanceHeadlineSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Buscar"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_text"
        style="@style/Widget.Material3.Button.TonalButton"
        android:textColor="@color/Negro"
        android:background="@drawable/fondo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Buscar por Texto"
        app:icon="@drawable/ic_keyboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messageTextView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/gridLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_text" />


    <TextView
        android:id="@+id/messageTextView"
        android:layout_width="230dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/fondo"
        android:backgroundTint="@color/barra"
        android:textSize="18sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <GridLayout
        android:id="@+id/gridLayout2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:columnCount="4"
        android:orientation="horizontal"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/key1"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:background="@drawable/fondo"
            android:textColor="@color/Negro"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="1"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key2"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="2"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key3"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="3"
            android:textSize="25sp" />

        <Button
            android:id="@+id/keyC"
            style="@style/Widget.Material3.Button.TonalButton"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="C"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key4"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="4"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key5"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="5"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key6"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="6"
            android:textSize="25sp" />

        <Button
            android:id="@+id/keyS"
            style="@style/Widget.Material3.Button.TonalButton"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="S"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key7"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="7"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key8"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="8"
            android:textSize="25sp" />

        <Button
            android:id="@+id/key9"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:textColor="@color/Negro"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="9"
            android:textSize="25sp" />

        <Button
            android:id="@+id/keyN"
            style="@style/Widget.Material3.Button.TonalButton"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="N"
            android:textSize="25sp" />

        <Button
            android:id="@+id/keyX"
            style="@style/Widget.Material3.Button.TonalButton"
            android:background="@drawable/fondo"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:paddingLeft="20dp"
            android:text="$"
            android:textSize="25sp"
            app:icon="@drawable/ic_delete"
            app:iconSize="25sp" />

        <Button
            android:id="@+id/key0"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:background="@drawable/fondo"
            android:textColor="@color/Negro"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:text="0"
            android:textSize="25sp" />

        <Button
            android:id="@+id/keyEnter"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:background="@drawable/fondo"
            android:visibility="gone"
            android:layout_height="60dp"
            android:layout_columnSpan="2"
            android:layout_gravity="fill"
            android:paddingLeft="58dp"
            android:textSize="25sp"
            app:icon="@drawable/ic_enter"
            app:iconSize="25sp" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>